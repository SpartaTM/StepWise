@{
    var code = (int)ViewBag.Code;
    ViewData["Title"] = code == 404 ? "Страница не найдена" : $"Ошибка {code}";
}

<div class="sw-empty-state text-center py-5 my-4 mx-auto" style="max-width: 520px;">
    <div class="sw-empty-icon mx-auto mb-3">
        <i class="bi @(code == 404 ? "bi-compass" : "bi-exclamation-triangle")"></i>
    </div>
    <div class="display-5 fw-bold text-primary mb-2">@code</div>
    <h2 class="fw-bold mb-2">@(code == 404 ? "Страница не найдена" : "Что-то пошло не так")</h2>
    <p class="text-muted mb-4">
        @(code == 404
            ? "Возможно, инструкция была удалена или вы перешли по устаревшей ссылке."
            : "Произошла непредвиденная ошибка при обработке запроса.")
    </p>
    <div class="d-flex justify-content-center gap-2">
        <a asp-controller="Instructions" asp-action="Index" class="btn sw-btn-primary px-4">
            <i class="bi bi-grid me-2"></i>В каталог
        </a>
        <a asp-controller="Home" asp-action="Index" class="btn sw-btn-outline px-4">На главную</a>
    </div>
</div>
