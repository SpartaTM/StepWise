@{
    ViewData["Title"] = "О проекте StepWise";
}

<div class="sw-card p-4 p-md-5 mx-auto" style="max-width: 800px;">
    <span class="badge bg-primary-subtle text-primary rounded-pill px-3 py-2 mb-3">TASKILLS Hackathon 2026</span>
    <h1 class="fw-bold mb-3">О платформе StepWise</h1>
    <p class="lead text-muted mb-4">
        StepWise решает проблему разрозненных и устаревающих инструкций: от настройки окружения разработки до бытовых и учебных задач.
    </p>
    <div class="row g-3 mb-4">
        <div class="col-sm-6">
            <div class="p-3 rounded-3 bg-light">
                <div class="fw-semibold mb-1"><i class="bi bi-shield-check text-primary me-2"></i>Приватность</div>
                <div class="small text-muted">Идентификация автора осуществляется через безопасную сессионную cookie без сбора лишних персональных данных.</div>
            </div>
        </div>
        <div class="col-sm-6">
            <div class="p-3 rounded-3 bg-light">
                <div class="fw-semibold mb-1"><i class="bi bi-code-slash text-primary me-2"></i>Стек технологий</div>
                <div class="small text-muted">ASP.NET Core MVC, Entity Framework Core, SQLite и современный адаптивный фронтенд.</div>
            </div>
        </div>
    </div>
    <a asp-controller="Instructions" asp-action="Index" class="btn sw-btn-primary">Перейти в каталог инструкций</a>
</div>
