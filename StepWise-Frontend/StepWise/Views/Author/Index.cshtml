@model List<StepWise.ViewModels.InstructionListItemViewModel>
@{
    ViewData["Title"] = "Мои инструкции";
}

<div class="d-flex flex-column flex-sm-row justify-content-between align-items-sm-center gap-3 mb-4">
    <div>
        <h1 class="sw-page-title mb-1">Кабинет автора</h1>
        <p class="text-muted mb-0">Управляйте созданными инструкциями и обновляйте шаги</p>
    </div>
    <a asp-action="Create" class="btn sw-btn-primary px-4">
        <i class="bi bi-plus-lg me-2"></i>Создать инструкцию
    </a>
</div>

@if (!Model.Any())
{
    <div class="sw-empty-state text-center py-5">
        <div class="sw-empty-icon mx-auto mb-3"><i class="bi bi-file-earmark-plus"></i></div>
        <h4 class="fw-bold">У вас пока нет инструкций</h4>
        <p class="text-muted mb-4 mx-auto" style="max-width: 440px;">
            Создайте свой первый пошаговый чек-лист — он сразу появится в общем каталоге и станет доступен для прохождения.
        </p>
        <a asp-action="Create" class="btn sw-btn-primary px-4">
            <i class="bi bi-plus-lg me-2"></i>Создать первую инструкцию
        </a>
    </div>
}
else
{
    <div class="sw-card overflow-hidden">
        <div class="table-responsive">
            <table class="table sw-table align-middle mb-0">
                <thead>
                    <tr>
                        <th class="ps-4">Название</th>
                        <th>Категория</th>
                        <th>Шагов</th>
                        <th class="text-end pe-4">Действия</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="ps-4 fw-semibold">
                                <a asp-controller="Instructions" asp-action="Details" asp-route-id="@item.Id" class="text-decoration-none text-dark hover-primary">
                                    @item.Title
                                </a>
                            </td>
                            <td>
                                <span class="sw-category-badge">@item.Category</span>
                            </td>
                            <td>
                                <span class="text-muted small"><i class="bi bi-list-ol me-1"></i>@item.StepsCount</span>
                            </td>
                            <td class="text-end pe-4">
                                <div class="d-inline-flex gap-2">
                                    <a asp-controller="Player" asp-action="Index" asp-route-instructionId="@item.Id" class="btn btn-sm sw-btn-icon" title="Пройти">
                                        <i class="bi bi-play-fill"></i>
                                    </a>
                                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm sw-btn-icon" title="Редактировать">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                    <form asp-action="Delete" asp-route-id="@item.Id" method="post"
                                          onsubmit="return confirm('Удалить инструкцию «@item.Title»?');" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-sm sw-btn-icon text-danger" title="Удалить">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
