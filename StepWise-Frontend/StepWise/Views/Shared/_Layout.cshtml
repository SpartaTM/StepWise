<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — StepWise</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/StepWise.styles.css" asp-append-version="true" />
</head>
<body class="d-flex flex-column min-vh-100">
    <header class="sticky-top sw-navbar">
        <nav class="navbar navbar-expand-md">
            <div class="container">
                <a class="navbar-brand sw-brand" asp-area="" asp-controller="Home" asp-action="Index">
                    <span class="sw-brand-icon"><i class="bi bi-check2-square"></i></span>
                    <span>StepWise</span>
                </a>
                <button class="navbar-toggler sw-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav"
                        aria-controls="mainNav" aria-expanded="false" aria-label="Открыть меню">
                    <i class="bi bi-list fs-4"></i>
                </button>
                <div class="collapse navbar-collapse" id="mainNav">
                    <ul class="navbar-nav me-auto mb-2 mb-md-0 gap-1 ms-md-4">
                        <li class="nav-item">
                            <a class="nav-link sw-nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Home" && ViewContext.RouteData.Values["action"]?.ToString() == "Index" ? "active" : "")"
                               asp-area="" asp-controller="Home" asp-action="Index">
                                <i class="bi bi-house-door me-1"></i>Главная
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link sw-nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Instructions" || ViewContext.RouteData.Values["controller"]?.ToString() == "Player" ? "active" : "")"
                               asp-area="" asp-controller="Instructions" asp-action="Index">
                                <i class="bi bi-compass me-1"></i>Каталог
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link sw-nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Author" ? "active" : "")"
                               asp-area="" asp-controller="Author" asp-action="Index">
                                <i class="bi bi-folder2-open me-1"></i>Мои инструкции
                            </a>
                        </li>
                    </ul>
                    <div class="d-flex align-items-center gap-2">
                        <a asp-controller="Author" asp-action="Create" class="btn sw-btn-primary btn-sm px-3 py-2">
                            <i class="bi bi-plus-lg me-1"></i>Создать гайд
                        </a>
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <main role="main" class="flex-grow-1 py-4 py-md-5">
        <div class="container">
            @RenderBody()
        </div>
    </main>

    <footer class="sw-footer py-4 mt-auto">
        <div class="container d-flex flex-column flex-sm-row justify-content-between align-items-center gap-2">
            <div class="d-flex align-items-center gap-2 text-muted small">
                <span class="fw-semibold text-dark">StepWise</span>
                <span>•</span>
                <span>От инструкции к результату © 2026</span>
            </div>
            <div class="d-flex gap-3 small">
                <a asp-controller="Instructions" asp-action="Index" class="sw-footer-link">Каталог</a>
                <a asp-controller="Author" asp-action="Index" class="sw-footer-link">Кабинет автора</a>
                <a asp-controller="Home" asp-action="Privacy" class="sw-footer-link">О проекте</a>
            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
