@model StepWise.ViewModels.InstructionDetailsViewModel
@{
    ViewData["Title"] = Model.Title;
    var estMinutes = Math.Max(2, Model.Steps.Count * 2);
}

<div class="mb-4">
    <a asp-controller="Instructions" asp-action="Index" class="sw-back-link">
        <i class="bi bi-arrow-left me-1"></i>Назад в каталог
    </a>
</div>

<div class="row g-4 align-items-start">
    <div class="col-lg-8">
        <div class="sw-card p-4 p-md-5 mb-4">
            <div class="d-flex flex-wrap align-items-center gap-2 mb-3">
                <span class="sw-category-badge">@Model.Category</span>
                <span class="text-muted small"><i class="bi bi-list-check me-1"></i>@Model.Steps.Count шагов</span>
                <span class="text-muted small">•</span>
                <span class="text-muted small"><i class="bi bi-clock me-1"></i>~@estMinutes мин</span>
            </div>
            <h1 class="sw-page-title mb-3">@Model.Title</h1>
            <p class="lead text-muted mb-0">@Model.Description</p>
        </div>

        <div class="d-flex justify-content-between align-items-center mb-3">
            <h2 class="h4 fw-bold mb-0">План действий (@Model.Steps.Count)</h2>
            <span class="text-muted small">Предпросмотр шагов</span>
        </div>

        <div class="sw-timeline">
            @foreach (var step in Model.Steps)
            {
                <div class="sw-timeline-item">
                    <div class="sw-timeline-marker">@step.Order</div>
                    <div class="sw-card p-3 p-md-4 flex-grow-1">
                        <h3 class="h6 fw-bold mb-1">@step.Title</h3>
                        @if (!string.IsNullOrWhiteSpace(step.Description))
                        {
                            <p class="text-muted mb-0 small">@step.Description</p>
                        }
                    </div>
                </div>
            }
        </div>
    </div>

    <div class="col-lg-4">
        <div class="sw-card p-4 sticky-lg-top" style="top: 90px;">
            <h5 class="fw-bold mb-2">Готовы приступить?</h5>
            <p class="text-muted small mb-4">
                Запустите интерактивный режим прохождения: отмечайте выполненные шаги и отслеживайте свой прогресс.
            </p>
            <a asp-controller="Player" asp-action="Index" asp-route-instructionId="@Model.Id" class="btn sw-btn-primary btn-lg w-100 mb-3">
                <i class="bi bi-play-fill me-1"></i>Начать прохождение
            </a>
            <button type="button" class="btn sw-btn-outline w-100" id="copyShareLinkBtn">
                <i class="bi bi-share me-2"></i>Скопировать ссылку
            </button>
        </div>
    </div>
</div>
