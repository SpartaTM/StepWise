@{
    var code = (int)ViewBag.Code;
    ViewData["Title"] = code == 404 ? "Не найдено" : "Ошибка";
}
<h1>@(code == 404? "Страница не найдена":"Что-то пошло не так")</h1>
<p>@(code == 404 ? "Такой инструкции или страницы нет." : $"Код ошибки:{code}")</p>
<a asp-controller="Instructions" asp-action="Index">Вернуться в каталог</a>
