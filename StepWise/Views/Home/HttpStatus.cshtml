@{
    var code = (int)ViewBag.Code;
    ViewData["Title"] = code == 404 ? "Не найдено" : "Ошибка";
}
<section class="status-page">
    <div class="status-code">@code</div>
    <h1>@(code == 404 ? "Страница не найдена" : "Что-то пошло не так")</h1>
    <p>@(code == 404 ? "Такой инструкции или страницы нет. Возможно, её удалили или ссылка устарела." : $"Код ошибки: {code}. Попробуйте обновить страницу или вернуться позже.")</p>
    <a class="btn btn-primary btn-lg" asp-controller="Instructions" asp-action="Index">Вернуться в каталог</a>
</section>
