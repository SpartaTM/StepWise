
@model StepWise.Models.Instruction

@{
    ViewData["Title"] = "Прохождение инструкции";

    var completedStepIds = (List<int>)ViewBag.CompletedStepIds;
    int progressPercent = (int)ViewBag.ProgressPercent;
    int progressId = (int)ViewBag.ProgressId;
}

<h1>@Model.Title</h1>

<p>@Model.Description</p>

<p>Прогресс: @progressPercent%</p>

<progress value="@progressPercent" max="100"></progress>

<h2>Шаги инструкции</h2>

<ol>
    @foreach (var step in Model.Steps.OrderBy(s => s.Order))
    {
        bool isCompleted = completedStepIds.Contains(step.Id);

        <li>
            <h3>@step.Title</h3>

            <p>@step.Description</p>

            @if (isCompleted)
            {
                <p>Выполнено</p>
            }

            <form asp-controller="Player"
                  asp-action="ToggleStep"
                  method="post">

                @Html.AntiForgeryToken()

                <input type="hidden"
                       name="progressId"
                       value="@progressId" />

                <input type="hidden"
                       name="stepId"
                       value="@step.Id" />

                <button type="submit">
                    @(isCompleted ? "Снять отметку" : "Выполнено")
                </button>
            </form>
        </li>
    }
</ol>

<a asp-controller="Instructions"
   asp-action="Details"
   asp-route-id="@Model.Id">
    Вернуться к инструкции
</a>
