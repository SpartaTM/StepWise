@model StepWise.ViewModels.InstructionFormViewModel
@{
    var isEdit = Model.Id.HasValue;
    ViewData["Title"] = isEdit ? "Редактирование инструкции" : "Новая инструкция";
}

<div class="mb-4">
    <a asp-action="Index" class="sw-back-link">
        <i class="bi bi-arrow-left me-1"></i>Назад к моим инструкциям
    </a>
</div>

<div class="mx-auto" style="max-width: 820px;">
    <div class="mb-4">
        <h1 class="sw-page-title mb-1">@ViewData["Title"]</h1>
        <p class="text-muted mb-0">Заполните основную информацию и распишите последовательность шагов</p>
    </div>

    <form asp-action="@(isEdit ? "Edit" : "Create")" asp-route-id="@Model.Id" method="post" id="instructionForm">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="Id" />

        @if (!ViewData.ModelState.IsValid && ViewData.ModelState[string.Empty]?.Errors.Count > 0)
        {
            <div class="alert alert-danger rounded-3 d-flex align-items-center gap-2 mb-4">
                <i class="bi bi-exclamation-circle-fill"></i>
                <div asp-validation-summary="ModelOnly" class="mb-0"></div>
            </div>
        }

        <div class="sw-card p-4 mb-4">
            <h2 class="h5 fw-bold mb-3"><i class="bi bi-info-circle text-primary me-2"></i>Основная информация</h2>

            <div class="mb-3">
                <label asp-for="Title" class="form-label fw-semibold">Название инструкции <span class="text-danger">*</span></label>
                <input asp-for="Title" class="form-control form-control-lg" placeholder="Например: Как установить Docker на Ubuntu" />
                <span asp-validation-for="Title" class="text-danger small"></span>
            </div>

            <div class="row g-3">
                <div class="col-md-5">
                    <label asp-for="Category" class="form-label fw-semibold">Категория <span class="text-danger">*</span></label>
                    <input asp-for="Category" list="category-list" class="form-control" placeholder="Выберите или введите..." />
                    <datalist id="category-list">
                        @foreach (var c in (List<string>)ViewBag.Categories)
                        {
                            <option value="@c"></option>
                        }
                    </datalist>
                    <span asp-validation-for="Category" class="text-danger small"></span>
                </div>
                <div class="col-md-7">
                    <label asp-for="Description" class="form-label fw-semibold">Краткое описание <span class="text-danger">*</span></label>
                    <textarea asp-for="Description" class="form-control" rows="2" placeholder="Кому и в какой ситуации поможет эта инструкция?"></textarea>
                    <span asp-validation-for="Description" class="text-danger small"></span>
                </div>
            </div>
        </div>

        <div class="sw-card p-4 mb-4">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <div>
                    <h2 class="h5 fw-bold mb-0"><i class="bi bi-list-check text-primary me-2"></i>Шаги выполнения</h2>
                    <p class="text-muted small mb-0">Заполните нужные шаги — пустые блоки автоматически игнорируются при сохранении</p>
                </div>
                <span class="badge bg-primary-subtle text-primary rounded-pill px-3 py-2" id="filledStepsBadge">
                    Заполнено: 0
                </span>
            </div>

            <div class="d-flex flex-column gap-3" id="stepsContainer">
                @for (int i = 0; i < Model.Steps.Count; i++)
                {
                    bool hasData = !string.IsNullOrWhiteSpace(Model.Steps[i].Title) || !string.IsNullOrWhiteSpace(Model.Steps[i].Description);
                    bool isVisible = i < 3 || hasData;

                    <div class="sw-step-editor @(isVisible ? "" : "d-none")" data-step-index="@i">
                        <input type="hidden" asp-for="Steps[i].Id" />
                        <div class="d-flex align-items-center justify-content-between mb-2">
                            <span class="sw-step-editor-badge">Шаг @(i + 1)</span>
                            @if (i >= 1)
                            {
                                <button type="button" class="btn btn-link btn-sm text-muted text-decoration-none p-0 clear-step-btn" title="Очистить шаг">
                                    <i class="bi bi-x-circle me-1"></i>Очистить
                                </button>
                            }
                        </div>
                        <div class="mb-2">
                            <input asp-for="Steps[i].Title" class="form-control step-title-input" placeholder="Заголовок шага (например: Установите зависимости)" />
                            <span asp-validation-for="Steps[i].Title" class="text-danger small"></span>
                        </div>
                        <div>
                            <textarea asp-for="Steps[i].Description" class="form-control step-desc-input" rows="2" placeholder="Подробное пояснение, команды или советы..."></textarea>
                            <span asp-validation-for="Steps[i].Description" class="text-danger small"></span>
                        </div>
                    </div>
                }
            </div>

            <div class="mt-3">
                <button type="button" id="addMoreStepBtn" class="btn sw-btn-outline btn-sm">
                    <i class="bi bi-plus-circle me-1"></i>Добавить ещё шаг
                </button>
            </div>
        </div>

        <div class="d-flex flex-wrap justify-content-end gap-2">
            <a asp-action="Index" class="btn sw-btn-outline px-4">Отмена</a>
            <button type="submit" class="btn sw-btn-primary px-4">
                <i class="bi bi-check2 me-1"></i>@(isEdit ? "Сохранить изменения" : "Опубликовать инструкцию")
            </button>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
