@model List<StepWise.ViewModels.InstructionListItemViewModel>
@{
    ViewData["Title"] = "Каталог инструкций";
    var categories = (List<string>)ViewBag.Categories;
    var selected = (string?)ViewBag.SelectedCategory;
    var sort = (string?)ViewBag.Sort;
    var search = (string?)ViewBag.Search;
    var hasFilters = !string.IsNullOrWhiteSpace(search) || !string.IsNullOrEmpty(selected);
}

<div class="page-head page-head-row">
    <div>
        <span class="eyebrow">Каталог</span>
        <h1>Каталог инструкций</h1>
        <p>Выберите инструкцию и проходите её шаг за шагом — прогресс сохранится.</p>
    </div>
    <a class="btn btn-primary" asp-controller="Author" asp-action="Create">+ Создать инструкцию</a>
</div>

<div class="catalog-tools">
    <!-- Поиск -->
    <form asp-action="Index" method="get" class="search-form" role="search">
        <label class="search-field">
            @await Html.PartialAsync("_Icon", "search")
            <input type="text"
                   name="search"
                   value="@search"
                   autocomplete="off"
                   aria-label="Поиск инструкций"
                   placeholder="Поиск по названию или описанию..." />
        </label>

        <input type="hidden" name="category" value="@selected" />
        <input type="hidden" name="sort" value="@sort" />

        @if (hasFilters)
        {
            <a asp-action="Index" class="search-reset">Сбросить</a>
        }
        <button type="submit" class="btn btn-primary">Найти</button>
    </form>

    <div class="toolbar">
        <!-- Фильтр категорий -->
        <div class="category-filter" aria-label="Категории">
            <a asp-action="Index"
               asp-route-search="@search"
               asp-route-sort="@sort"
               class="@(string.IsNullOrEmpty(selected) ? "active" : "")">
                Все
            </a>

            @foreach (var c in categories)
            {
                <a asp-action="Index"
                   asp-route-category="@c"
                   asp-route-sort="@sort"
                   asp-route-search="@search"
                   class="@(c == selected ? "active" : "")">
                    @c
                </a>
            }
        </div>

        <!-- Сортировка -->
        <div class="sort-links" aria-label="Сортировка">
            <a asp-action="Index"
               asp-route-category="@selected"
               asp-route-search="@search"
               class="@(sort != "rating" ? "active" : "")">
                По умолчанию
            </a>

            <a asp-action="Index"
               asp-route-category="@selected"
               asp-route-search="@search"
               asp-route-sort="rating"
               class="@(sort == "rating" ? "active" : "")">
                Сначала популярные
            </a>
        </div>
    </div>
</div>

@if (!Model.Any())
{
    <div class="empty-state">
        <div class="empty-icon">@await Html.PartialAsync("_Icon", "search")</div>
        <h3>Ничего не найдено</h3>
        <p>Попробуйте изменить запрос или сбросить фильтры. Можно также создать свою инструкцию.</p>
        <div>
            <a asp-action="Index" class="btn">Сбросить фильтры</a>
            <a asp-controller="Author" asp-action="Create" class="btn btn-primary">Создать инструкцию</a>
        </div>
    </div>
}
else
{
    <p class="results-note">Найдено: @Model.Count</p>

    <!-- Карточки инструкций -->
    <div class="instruction-grid">
        @foreach (var item in Model)
        {
            <article class="instruction-card">
                <div class="card-top">
                    <partial name="_CategoryChip" model="item.Category" />
                    @if (item.RatingsCount > 0)
                    {
                        <span class="rating"><span class="star">★</span> @item.AverageRating.ToString("0.0") <small>(@item.RatingsCount)</small></span>
                    }
                    else
                    {
                        <span class="rating"><small>Нет оценок</small></span>
                    }
                </div>

                <h3>
                    <a asp-controller="Instructions" asp-action="Details" asp-route-id="@item.Id">@item.Title</a>
                </h3>

                <div class="card-meta">
                    <span class="step-count">
                        @await Html.PartialAsync("_Icon", "list")
                        Шагов: @item.StepsCount
                    </span>
                    <span class="card-go" aria-hidden="true">@await Html.PartialAsync("_Icon", "arrow-right")</span>
                </div>
            </article>
        }
    </div>
}
