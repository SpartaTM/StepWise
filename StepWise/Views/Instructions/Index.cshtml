@model List<StepWise.ViewModels.InstructionListItemViewModel>
@{
    ViewData["Title"] = "Каталог инструкций";
    var categories = (List<string>)ViewBag.Categories;
    var selected = (string?)ViewBag.SelectedCategory;
    var sort = (string?)ViewBag.Sort;

}

<h1>Каталог инструкций</h1>
<div class="category-filter">
    <a asp-action="Index" class="@(string.IsNullOrEmpty(selected) ? "active" : "")">Все</a>
    @foreach (var c in categories)
    {
        <a asp-action="Index" asp-route-category="@c" asp-route-sort="@sort" class="@(c == selected ? "active" : "")">@c</a>
    }
</div>
<div class="instruction-grid">
    @foreach (var item in Model)
    {
        <div class="instruction-card">
            <h3>@item.Title</h3>
            <p class="category">@item.Category</p>
            <p>Шагов: @item.StepsCount</p>
            @if (item.RatingsCount > 0)
            {
                <p class="rating">★ @item.AverageRating.ToString("0.0") (@item.RatingsCount)</p>
            }
            <a asp-controller="Instructions" asp-action="Details" asp-route-id="@item.Id">Открыть</a>
        </div>
    }
</div>
<div class="sort-links">
    <a asp-action="Index" asp-route-category="@selected"
       class="@(sort != "rating" ? "active" : "")">По умолчанию</a>
    <a asp-action="Index" asp-route-category="@selected" asp-route-sort="rating"
       class="@(sort == "rating" ? "active" : "")">Сначала популярные</a>
</div>
