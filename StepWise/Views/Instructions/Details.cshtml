@model StepWise.ViewModels.InstructionDetailsViewModel
@{
    ViewData["Title"] = Model.Title;
}

<a asp-controller="Instructions" asp-action="Index">← Назад в каталог</a>

<h1>@Model.Title</h1>
<p class="category">@Model.Category</p>
<p>@Model.Description</p>
@if (Model.ForkedFromTitle != null)
{
    <p class="forked-from">
        Улучшенная версия инструкции
        <a asp-action="Details" asp-route-id="@Model.ForkedFromId">«@Model.ForkedFromTitle»</a>
    </p>
}

@if (Model.ForksCount > 0)
{
    <p class="forks-count">Улучшенных версий: @Model.ForksCount</p>
}

@if (Model.IsMine)
{
    <a asp-controller="Author" asp-action="Edit" asp-route-id="@Model.Id" class="btn-edit">Редактировать</a>
}
else
{
    <form asp-action="Fork" asp-route-id="@Model.Id" method="post" class="fork-form">
        <button type="submit" class="btn-fork">Улучшить: создать свою копию</button>
    </form>
}

<h2>Шаги (@Model.Steps.Count)</h2>
<ol class="steps-list">
    @foreach (var step in Model.Steps)
    {
        <li>
            <strong>@step.Title</strong>
            <p>@step.Description</p>
        </li>
    }
</ol>
<div class="rating-block">
    <p>
        Полезность:
        @(Model.RatingsCount == 0
            ? "пока нет оценок"
            : $"{Model.AverageRating:0.0} из 5 ({Model.RatingsCount})")
    </p>

    <form asp-action="Rate" asp-route-id="@Model.Id" method="post" class="rating-form">
        <span>Ваша оценка:</span>
        @for (int v = 1; v <= 5; v++)
        {
            <button type="submit" name="value" value="@v"
                    class="@(Model.MyRating == v ? "active" : "")">
                @v
            </button>
        }
    </form>
</div>

<a asp-controller="Player" asp-action="Index" asp-route-instructionId="@Model.Id" class="btn-start">Начать прохождение</a>