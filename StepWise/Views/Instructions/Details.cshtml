@model StepWise.ViewModels.InstructionDetailsViewModel
@{
    ViewData["Title"] = Model.Title;
}

<a class="back-link" asp-controller="Instructions" asp-action="Index">← Назад в каталог</a>

<div class="details">
    <div class="details-main">
        <header class="card details-head">
            <div class="chips">
                <partial name="_CategoryChip" model="Model.Category" />
                @if (Model.IsMine)
                {
                    <span class="chip chip-success">Ваша инструкция</span>
                }
            </div>

            <h1>@Model.Title</h1>
            <p class="lead">@Model.Description</p>

            <div class="details-meta">
                <span>@await Html.PartialAsync("_Icon", "list") Шагов: @Model.Steps.Count</span>
                @if (Model.RatingsCount > 0)
                {
                    <span><span style="color:var(--star)">★</span> @Model.AverageRating.ToString("0.0") (@Model.RatingsCount)</span>
                }
                @if (Model.ForksCount > 0)
                {
                    <span class="forks-count">@await Html.PartialAsync("_Icon", "fork") Улучшенных версий: @Model.ForksCount</span>
                }
            </div>

            <a asp-controller="Player" asp-action="Index" asp-route-instructionId="@Model.Id" class="btn btn-primary btn-lg mobile-cta no-print">Начать прохождение</a>

            @if (Model.ForkedFromTitle != null)
            {
                <p class="notice forked-from">
                    @await Html.PartialAsync("_Icon", "fork")
                    <span>
                        Улучшенная версия инструкции
                        <a asp-action="Details" asp-route-id="@Model.ForkedFromId">«@Model.ForkedFromTitle»</a>
                    </span>
                </p>
            }
        </header>

        <section class="card">
            <h2>Шаги (@Model.Steps.Count)</h2>
            <ol class="steps-list">
                @foreach (var step in Model.Steps)
                {
                    <li>
                        <span class="step-num">@step.Order</span>
                        <div class="step-body">
                            <strong>@step.Title</strong>
                            @if (!string.IsNullOrWhiteSpace(step.Description))
                            {
                                <p>@step.Description</p>
                            }
                        </div>
                    </li>
                }
            </ol>
        </section>
    </div>

    <aside class="details-aside">
        <div class="card aside-card">
            <h3>Готовы начать?</h3>
            <div class="aside-actions">
                <a asp-controller="Player" asp-action="Index" asp-route-instructionId="@Model.Id" class="btn btn-primary btn-lg btn-block btn-start">Начать прохождение</a>

                @if (CurrentUser.IsExpert)
                {
                    if (Model.IsMine)
                    {
                        <a asp-controller="Author" asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-block">Редактировать</a>
                    }
                    else
                    {
                        <form asp-action="Fork" asp-route-id="@Model.Id" method="post" class="fork-form">
                            <button type="submit" class="btn btn-block">@await Html.PartialAsync("_Icon", "fork") Улучшить: создать копию</button>
                        </form>
                    }
                }

                <button type="button" class="btn btn-ghost btn-block no-print" onclick="window.print()">@await Html.PartialAsync("_Icon", "printer") Печать / сохранить в PDF</button>
            </div>

            @if (!CurrentUser.IsExpert)
            {
                <p class="aside-hint">Хотите улучшить эту инструкцию? Переключитесь на режим эксперта в шапке сайта.</p>
            }
            else if (!Model.IsMine)
            {
                <p class="aside-hint">Копию можно доработать под себя — оригинал останется без изменений.</p>
            }
        </div>

        <div class="card aside-card rating-block">
            <h3>Полезность</h3>
            <div class="rating-score">
                @if (Model.RatingsCount == 0)
                {
                    <span>Пока нет оценок. Станьте первым!</span>
                }
                else
                {
                    <b>@Model.AverageRating.ToString("0.0")</b>
                    <span>из 5 · оценок: @Model.RatingsCount</span>
                }
            </div>

            <form asp-action="Rate" asp-route-id="@Model.Id" method="post" class="rating-form">
                <span>@(Model.MyRating.HasValue ? "Ваша оценка" : "Оцените инструкцию")</span>
                <div class="stars" role="group" aria-label="Оценка от 1 до 5">
                    @for (int v = 5; v >= 1; v--)
                    {
                        <button type="submit" name="value" value="@v"
                                aria-label="Оценить на @v"
                                title="@v из 5"
                                class="@(Model.MyRating.HasValue && v <= Model.MyRating.Value ? "on" : "")">★</button>
                    }
                </div>
            </form>
        </div>
    </aside>
</div>
