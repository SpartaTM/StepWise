@model ErrorViewModel
@{
    ViewData["Title"] = "Ошибка";
}
<section class="status-page">
    <div class="status-code">500</div>
    <h1>Что-то пошло не так</h1>
    <p>Мы уже знаем о проблеме. Попробуйте обновить страницу или вернуться в каталог.</p>
    @if (Model.ShowRequestId)
    {
        <p>Код запроса: <code>@Model.RequestId</code></p>
    }
    <a class="btn btn-primary btn-lg" asp-controller="Instructions" asp-action="Index">Вернуться в каталог</a>
</section>
