<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#f6f8fd" />
    <meta name="description" content="StepWise — интерактивные пошаговые инструкции с чек-листами и прогрессом." />
    <title>@ViewData["Title"] — StepWise</title>
    <link rel="icon" type="image/svg+xml" href="~/img/logo.svg" />
    <link rel="icon" href="~/favicon.ico" sizes="any" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
@{
    var ctrl = (ViewContext.RouteData.Values["controller"] as string) ?? "";
    string Active(params string[] names) => names.Contains(ctrl) ? "is-active" : "";
}
<body>
    <header class="site-header" id="site-header">
        <div class="container header-inner">
            <a class="brand" asp-controller="Home" asp-action="Index" aria-label="StepWise — на главную">
                <img src="~/img/logo.svg" alt="" width="36" height="36" />
                <span>Step<b>Wise</b></span>
            </a>

            <nav class="main-nav" id="main-nav" aria-label="Основная навигация">
                <a class="nav-link @Active("Instructions", "Player")" asp-controller="Instructions" asp-action="Index">Каталог</a>

                @if (CurrentUser.IsExpert)
                {
                    <a class="nav-link @Active("Author")" asp-controller="Author" asp-action="Index">Мои инструкции</a>
                }

                <form asp-controller="Account" asp-action="SetRole" method="post" class="role-switch" role="group" aria-label="Режим просмотра">
                    <input type="hidden" name="returnUrl" value="@(Context.Request.Path + Context.Request.QueryString)" />
                    <button type="submit" name="role" value="student" class="@(CurrentUser.IsExpert ? "" : "active")" aria-pressed="@(CurrentUser.IsExpert ? "false" : "true")">Ученик</button>
                    <button type="submit" name="role" value="expert" class="@(CurrentUser.IsExpert ? "active" : "")" aria-pressed="@(CurrentUser.IsExpert ? "true" : "false")">Эксперт</button>
                </form>

                @if (CurrentUser.IsExpert)
                {
                    <a class="btn btn-primary btn-sm header-cta" asp-controller="Author" asp-action="Create">+ Создать инструкцию</a>
                }
            </nav>

            <button class="burger" type="button" id="burger" aria-label="Открыть меню" aria-expanded="false" aria-controls="main-nav">
                <span></span>
            </button>
        </div>
    </header>

    <main role="main" class="container page">
        @RenderBody()
    </main>

    <footer class="site-footer">
        <div class="container footer-inner">
            <a class="brand" asp-controller="Home" asp-action="Index">
                <img src="~/img/logo.svg" alt="" width="28" height="28" />
                <span>Step<b>Wise</b></span>
            </a>
            <span>Делаем сложное простым — шаг за шагом · © 2026</span>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
    
</body>

</html>
